#!/bin/bash
set -o pipefail
${DEBUG:+eval $(debugtrace -o $- -- "$@")}

printUsage()
{
    cat <<HELPTEXT
Run a (non-interactive) update check for all available setup-*-software
commands, and print any definitions that can be updated.

EXIT STATUS:
    0	Updates found.
    1	No updates found.
    99	No software updaters found.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[SETUP-SOFTWARE-ARGS ...] [-?|-h|--help]'
}

case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

status=
exec 3<&0
while IFS=$'\n' read -r updateSoftwareCommand
do
    SUDO=exit99 "$updateSoftwareCommand" --check --print-definitions --quiet "$@" <&3 \
	| prefix -- '- ' \
	| outputAndPrintf '%s has updates:\n' "$(basename -- "$updateSoftwareCommand")" \
	    && status=0 || : ${status:=$?}
done < <(pathglob 'update-*-software')
exit ${status:-99}
